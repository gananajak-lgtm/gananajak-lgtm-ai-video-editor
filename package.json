{
  "name": "gananajak-ai-video-editor",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted automatic video editor for story-driven videos",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && tsc -p tsconfig.electron.json && electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "smoke:render": "node scripts/render-smoke.cjs",
    "test:content": "npm run build:electron && node --test dist-electron/main/content-local-test-assets.test.js dist-electron/main/content-asset-runner.test.js dist-electron/main/content-narration-runner.test.js dist-electron/main/content-timeline-bridge.test.js dist-electron/main/content-factory.integration.test.js dist-electron/main/video/render.test.js dist-electron/main/content-batch.test.js dist-electron/main/content-batch-assets.test.js dist-electron/main/content-batch-render.test.js",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^35.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.gananajak.aivideoeditor",
    "productName": "Gananajak AI Video Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Gananajak-AI-Video-Editor-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gananajak AI Video Editor"
    }
  }
}
