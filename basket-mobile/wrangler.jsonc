{
  "name": "gananajak-basket-studio",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "OPENAI_MODEL": "gpt-4.1-mini"
  }
}
